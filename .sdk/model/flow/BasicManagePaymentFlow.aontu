# BasicManagePaymentFlow

main: kit: flow: BasicManagePaymentFlow:
{
  entity: "manage_payment",
  kind: "basic",
  name: "BasicManagePaymentFlow",
  step: [
    {
      i: {
        ref: "manage_payment_ref01"
      }

      m: {
        standing_order_id: "standing_order01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "manage_payment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "manage_payment_ref01",
        srcdatavar: "manage_payment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "manage_payment01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-manage_payment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicManagePaymentFlow"
}