                t: "`$STRING`"
              }
              {
                k: "query"
                n: "product"
                or: "product"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/payments/providers"
          q: {
            exist: [
              "country"
              "product"
              "type"
              "x_client_id"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "payments"
