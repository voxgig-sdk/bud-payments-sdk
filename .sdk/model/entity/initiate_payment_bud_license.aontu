                or: "x_client_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/payments/standing-order/bud-pay-url"
          q: {
            exist: [
              "x_client_id"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "payments"
            }
            {
              lit: "standing-order"
            }
            {
              lit: "bud-pay-url"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/payments/providers"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "8711bbef-b357-4c2d-97ca-0d9df4206e9a"
                k: "header"
                n: "x_client_id"
                or: "x_client_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "GBR,DEU"
                k: "query"
                n: "country"
                or: "country"
